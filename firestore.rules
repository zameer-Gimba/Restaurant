rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Must match ADMIN_UID in public/admin/index.html.
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'AaO71KqiEtYpivEEMOfkbQH31i63';
    }

    function isString(field, maxLen) {
      return request.resource.data[field] is string
        && request.resource.data[field].size() <= maxLen;
    }

    // Shape of an order written by public/index.html.
    function isValidNewOrder() {
      let d = request.resource.data;
      return d.keys().hasOnly(['orderId', 'customerName', 'phone', 'type', 'amount',
                               'payMode', 'address', 'items', 'time', 'status', 'createdAt'])
        && d.keys().hasAll(['customerName', 'phone', 'type', 'amount', 'items', 'status', 'createdAt'])
        && isString('customerName', 100) && d.customerName.size() > 0
        && isString('phone', 30) && d.phone.size() > 0
        && d.type in ['TAKE AWAY', 'DELIVERY', 'DINE IN']
        && d.amount is number && d.amount > 0 && d.amount <= 10000000
        && d.items is list && d.items.size() > 0 && d.items.size() <= 100
        && d.status == 'pending'
        && d.createdAt == request.time
        && (!('orderId' in d) || isString('orderId', 20))
        && (!('payMode' in d) || isString('payMode', 40))
        && (!('address' in d) || isString('address', 300))
        && (!('time' in d) || isString('time', 40));
    }

    // Menu and restaurant settings: public to read, admin-only to change.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      // Customers place orders, and can follow one order by its (random, unguessable) document ID.
      allow create: if isAdmin() || isValidNewOrder();
      allow get: if true;
      // Only the admin can see the full list of orders (customer names and phone numbers) or change them.
      allow list, update, delete: if isAdmin();
    }

    // Anything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
