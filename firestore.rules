rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'AaO71KqiEtYpivEEMOfkbQH31i63';
    }

    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/restaurant {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /Customers/{id} {
      allow read, write: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll([
          'ownerUid', 'orderId', 'customerName', 'phone',
          'type', 'amount', 'payMode', 'address',
          'items', 'time', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'orderId', 'customerName', 'phone',
          'type', 'amount', 'payMode', 'address',
          'items', 'time', 'status', 'createdAt'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.orderId is string
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() > 0
        && request.resource.data.customerName.size() <= 120
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 40
        && request.resource.data.type is string
        && request.resource.data.type.size() <= 40
        && request.resource.data.amount is number
        && request.resource.data.amount >= 0
        && request.resource.data.amount <= 100000000
        && request.resource.data.payMode is string
        && request.resource.data.payMode.size() <= 50
        && request.resource.data.address is string
        && request.resource.data.address.size() <= 500
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && request.resource.data.time is string
        && request.resource.data.time.size() <= 100
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;

      allow read: if isAdmin()
        || (request.auth != null
            && resource.data.ownerUid == request.auth.uid);

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['status'])
        && request.resource.data.status in [
          'pending', 'paid', 'accepted', 'done', 'cancelled'
        ];

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
